# Public site URL used by canonical, sitemap and social metadata.
NEXT_PUBLIC_SITE_URL=https://akintemiz.com

# Umami Cloud tracking. Website ID is public in the rendered tracker tag.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Paste only the Google Search Console HTML-tag verification token.
GOOGLE_SITE_VERIFICATION=

# Existing Sanity and contact form settings are intentionally omitted here.
# Copy their names from the deployment environment; never commit real secrets.
